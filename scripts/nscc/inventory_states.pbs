#!/bin/bash
#PBS -q normal
#PBS -P personal-veer001
#PBS -l select=1:ncpus=4:mem=16GB
#PBS -l walltime=00:30:00
#PBS -N meridian-state-inventory
#PBS -j oe
#PBS -o /scratch/users/ntu/veer001/meridian_labs/jobs/logs/

set -euo pipefail
: "${CONFIG_FILE:?absolute cluster path to the locked physical-boundary config}"
: "${RUN_ID:?unique inventory run ID}"

ROOT=/scratch/users/ntu/veer001/meridian_labs
OPENPI_ROOT="$ROOT/src/openpi"
RUN_ROOT="$ROOT/artifacts/state-inventory/$RUN_ID/$PBS_JOBID"
mkdir -p "$RUN_ROOT"

module load python/3.8.13
export LIBERO_CONFIG_PATH="$ROOT/config/libero"
export PYTHONPATH="$ROOT/harness/src:$ROOT/harness:$OPENPI_ROOT/third_party/libero"
export PYTHONUNBUFFERED=1
# LIBERO's default macro forces EGL on Linux even when ControlEnv never renders.
# GLX selects the lazy GLFW import path, so CPU-only state inspection needs no GPU display.
export MUJOCO_GL=glx

"$ROOT/envs/libero/bin/python" "$ROOT/harness/scripts/inventory_libero_initial_states.py" \
  --config "$CONFIG_FILE" \
  --output "$RUN_ROOT/initial-states.jsonl" \
  > >(tee "$RUN_ROOT/inventory.log") 2>&1

printf 'config=%s\n' "$CONFIG_FILE" > "$RUN_ROOT/inputs.txt"
find "$RUN_ROOT" -type f ! -name SHA256SUMS -print0 \
  | sort -z | xargs -0 sha256sum > "$RUN_ROOT/SHA256SUMS"
