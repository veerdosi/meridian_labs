#!/bin/bash
#PBS -q normal
#PBS -P personal-veer001
#PBS -l select=1:ngpus=1
#PBS -l walltime=01:00:00
#PBS -N meridian-openpi-env
#PBS -j oe
#PBS -o /scratch/users/ntu/veer001/meridian_labs/jobs/logs/

set -euo pipefail

ROOT=/scratch/users/ntu/veer001/meridian_labs
OPENPI_ROOT="$ROOT/src/openpi"
export OPENPI_DATA_HOME="$ROOT/cache/openpi"
export UV_CACHE_DIR="$ROOT/cache/uv"
export UV_PROJECT_ENVIRONMENT="$ROOT/envs/openpi"
export UV_LINK_MODE=copy
export PATH="$ROOT/bin:$PATH"

mkdir -p "$ROOT/jobs/logs" "$OPENPI_DATA_HOME" "$UV_CACHE_DIR" "$ROOT/envs"
module load python/3.11.7-gcc11 cuda/12.2.2

printf 'job_id=%s\n' "$PBS_JOBID"
printf 'host=%s\n' "$(hostname)"
printf 'openpi_revision=15a9616a00943ada6c20a0f158e3adb39df2ccac\n'
nvidia-smi --query-gpu=name,uuid,driver_version,memory.total --format=csv,noheader

cd "$OPENPI_ROOT"
uv sync --frozen --no-dev --no-install-package rerun-sdk --no-install-package lerobot
uv pip install --python "$UV_PROJECT_ENVIRONMENT/bin/python" --no-deps -e "$ROOT/src/lerobot"

"$UV_PROJECT_ENVIRONMENT/bin/python" - <<'PY'
import jax
import torch

print("jax", jax.__version__, "devices", jax.devices())
print("torch", torch.__version__, "cuda", torch.cuda.is_available())
PY
