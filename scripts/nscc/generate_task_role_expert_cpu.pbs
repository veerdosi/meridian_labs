#!/bin/bash
#PBS -q normal
#PBS -P personal-veer001
#PBS -l select=1:ncpus=16:mem=32GB
#PBS -l walltime=01:00:00
#PBS -N role-expert-cpu
#PBS -j oe
#PBS -o /scratch/users/ntu/veer001/meridian_labs/jobs/logs/

set -euo pipefail
: "${CONFIG:?absolute path to the locked task-role repair config}"
: "${PLANS:?absolute path to one materialized expert plan}"
: "${RUN_ID:?unique expert-generation run ID}"
: "${PHASE:?development, validation, or training}"

ROOT=/scratch/users/ntu/veer001/meridian_labs
RUN_ROOT="$ROOT/artifacts/task-role-expert/$RUN_ID/$PBS_JOBID"
WRITE_VIDEOS=${WRITE_VIDEOS:-1}
RENDER_BACKEND=${RENDER_BACKEND:-egl}
mkdir -p "$RUN_ROOT"

module load python/3.8.13
export LIBERO_CONFIG_PATH="$ROOT/config/libero"
export PYTHONPATH="$ROOT/harness/src:$ROOT/harness:$ROOT/src/openpi/third_party/libero"
export PYTHONUNBUFFERED=1
export MUJOCO_GL="$RENDER_BACKEND"
unset CUDA_VISIBLE_DEVICES MUJOCO_EGL_DEVICE_ID

VIDEO_FLAG=()
if [ "$WRITE_VIDEOS" = 1 ]; then VIDEO_FLAG=(--write-videos); fi
printf 'config=%s\nplans=%s\nphase=%s\nwrite_videos=%s\nrender_backend=%s\n' \
  "$CONFIG" "$PLANS" "$PHASE" "$WRITE_VIDEOS" "$RENDER_BACKEND" \
  > "$RUN_ROOT/inputs.txt"
sha256sum "$CONFIG" "$PLANS" > "$RUN_ROOT/input-sha256.txt"
while IFS= read -r bddl; do
  sha256sum "$ROOT/harness/$bddl"
done < <("$ROOT/envs/libero/bin/python" -c \
  'import json,sys; print("\n".join(sorted({json.loads(x)["bddl"] for x in open(sys.argv[1]) if x.strip()})))' \
  "$PLANS") >> "$RUN_ROOT/input-sha256.txt"
started=$(date +%s)
"$ROOT/envs/libero/bin/python" "$ROOT/harness/scripts/libero_task_role_expert.py" \
  --config "$CONFIG" \
  --plans "$PLANS" \
  --project-root "$ROOT/harness" \
  --output "$RUN_ROOT/generation" \
  "${VIDEO_FLAG[@]}" \
  > >(tee "$RUN_ROOT/generation.log") 2>&1
generated=$(date +%s)
"$ROOT/envs/libero/bin/python" "$ROOT/harness/scripts/verify_task_role_expert.py" \
  --config "$CONFIG" \
  --plans "$PLANS" \
  --results "$RUN_ROOT/generation/episodes.jsonl" \
  --phase "$PHASE" \
  --output "$RUN_ROOT/verification.json" \
  > >(tee "$RUN_ROOT/verification.log") 2>&1
verified=$(date +%s)

printf '{"generation_seconds":%d,"verification_seconds":%d}\n' \
  "$((generated-started))" "$((verified-generated))" > "$RUN_ROOT/phase-times.json"
find "$RUN_ROOT" -type f ! -name SHA256SUMS -print0 \
  | sort -z | xargs -0 sha256sum > "$RUN_ROOT/SHA256SUMS"
