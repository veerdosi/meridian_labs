#!/bin/bash
#PBS -q normal
#PBS -P personal-veer001
#PBS -l select=1:ncpus=4:mem=32GB
#PBS -l walltime=00:30:00
#PBS -N meridian-select-data
#PBS -j oe
#PBS -o /scratch/users/ntu/veer001/meridian_labs/jobs/logs/

set -euo pipefail
: "${CONFIG:?absolute path to the locked boundary config}"
: "${SOURCES:?absolute path to the verified source registry}"
: "${INVENTORY:?absolute path to the completed state inventory}"
: "${RUN_ID:?unique selection run ID}"
: "${RANDOM_SEED:?locked same-task random-control seed}"

ROOT=/scratch/users/ntu/veer001/meridian_labs
RUN_ROOT="$ROOT/artifacts/data-selection/$RUN_ID/$PBS_JOBID"
mkdir -p "$RUN_ROOT"

module load python/3.11.7-gcc11
export PYTHONPATH="$ROOT/harness/src:$ROOT/harness"
export PYTHONUNBUFFERED=1

"$ROOT/envs/openpi/bin/python" "$ROOT/harness/scripts/select_task_role_demos.py" \
  --config "$CONFIG" \
  --sources "$SOURCES" \
  --inventory "$INVENTORY" \
  --random-seed "$RANDOM_SEED" \
  --output-dir "$RUN_ROOT/selection" \
  > >(tee "$RUN_ROOT/selection.log") 2>&1

printf 'config=%s\nsources=%s\ninventory=%s\nrandom_seed=%s\n' \
  "$CONFIG" "$SOURCES" "$INVENTORY" "$RANDOM_SEED" > "$RUN_ROOT/inputs.txt"
find "$RUN_ROOT" -type f ! -name SHA256SUMS -print0 \
  | sort -z | xargs -0 sha256sum > "$RUN_ROOT/SHA256SUMS"
