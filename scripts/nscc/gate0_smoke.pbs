#!/bin/bash
#PBS -q normal
#PBS -P personal-veer001
#PBS -l select=1:ngpus=1
#PBS -l walltime=01:30:00
#PBS -N meridian-pi05-gate0
#PBS -j oe
#PBS -o /scratch/users/ntu/veer001/meridian_labs/jobs/logs/

set -euo pipefail

ROOT=/scratch/users/ntu/veer001/meridian_labs
OPENPI_ROOT="$ROOT/src/openpi"
RUN_ROOT="$ROOT/artifacts/gate0/$PBS_JOBID"
export OPENPI_DATA_HOME="$ROOT/cache/openpi"
export UV_CACHE_DIR="$ROOT/cache/uv"
export LIBERO_CONFIG_PATH="$ROOT/config/libero"
export PYTHONPATH="$OPENPI_ROOT/packages/openpi-client/src:$OPENPI_ROOT/third_party/libero"
export MUJOCO_GL=egl
export MUJOCO_EGL_DEVICE_ID=0
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.85
export PYTHONUNBUFFERED=1

mkdir -p "$RUN_ROOT" "$ROOT/jobs/logs"
module load python/3.11.7-gcc11 cuda/12.2.2

nvidia-smi --query-gpu=timestamp,name,uuid,utilization.gpu,memory.used,power.draw --format=csv -l 10 > "$RUN_ROOT/gpu.csv" &
MONITOR_PID=$!
SERVER_PID=
cleanup() {
  if [ -n "$SERVER_PID" ]; then kill "$SERVER_PID" 2>/dev/null || true; fi
  kill "$MONITOR_PID" 2>/dev/null || true
}
trap cleanup EXIT

cd "$OPENPI_ROOT"
"$ROOT/envs/openpi/bin/python" scripts/serve_policy.py --env LIBERO --port 8000 --record > "$RUN_ROOT/server.log" 2>&1 &
SERVER_PID=$!

"$ROOT/envs/openpi/bin/python" - <<'PY'
import socket
import time

deadline = time.monotonic() + 1200
while time.monotonic() < deadline:
    try:
        with socket.create_connection(("127.0.0.1", 8000), timeout=2):
            break
    except OSError:
        time.sleep(5)
else:
    raise TimeoutError("OpenPI policy server did not become ready within 20 minutes")
PY

"$ROOT/envs/libero/bin/python" "$ROOT/harness/scripts/openpi_libero_rollout.py" \
  --plans "$ROOT/harness/configs/pi05_gate0_plans.jsonl" \
  --output "$RUN_ROOT/rollouts"

printf 'openpi_revision=15a9616a00943ada6c20a0f158e3adb39df2ccac\n' > "$RUN_ROOT/revisions.txt"
printf 'libero_revision=f78abd68ee283de9f9be3c8f7e2a9ad60246e95c\n' >> "$RUN_ROOT/revisions.txt"
find "$RUN_ROOT" -type f -print0 | sort -z | xargs -0 sha256sum > "$RUN_ROOT/SHA256SUMS"
